Bootstrap: docker
From: nvidia/cuda:12.8.1-cudnn-runtime-ubuntu22.04

%labels
    Version 1.0
    Description General-purpose AI/ML Apptainer image for Berzelius HPC

%environment
    export PATH=/opt/miniforge3/bin:$PATH
    export PYTHONNOUSERSITE=True
    export PYTHONUNBUFFERED=1
    export PIP_NO_CACHE_DIR=1
    export PIP_ROOT_USER_ACTION=ignore

%post
    set -eux

    # ============================================================
    # 1. System packages
    # ============================================================
    apt-get update

    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        git \
        curl \
        wget \
        nano \
        vim \
        ca-certificates \
        build-essential \
        pkg-config \
        libgomp1

    # ============================================================
    # 2. Miniforge
    # ============================================================
    cd /tmp

    wget -O Miniforge3.sh \
        "https://github.com/conda-forge/miniforge/releases/download/26.3.2-2/Miniforge3-26.3.2-2-Linux-x86_64.sh"

    bash Miniforge3.sh -b -p /opt/miniforge3
    rm -f Miniforge3.sh

    export PATH=/opt/miniforge3/bin:$PATH

    # ============================================================
    # 3. Conda-forge packages in one transaction
    #    Keeping these in one solve is substantially faster than
    #    many consecutive mamba install operations.
    # ============================================================
    mamba install -y -c conda-forge \
        python=3.11 \
        pip \
        numpy \
        scipy \
        pandas \
        polars \
        pyarrow \
        scikit-learn \
        statsmodels \
        joblib \
        xgboost \
        lightgbm \
        catboost \
        imbalanced-learn \
        optuna \
        shap \
        umap-learn \
        h5py \
        zarr \
        openpyxl \
        xlsxwriter \
        matplotlib \
        seaborn \
        plotly \
        nibabel \
        nilearn \
        networkx \
        biopython \
        anndata \
        scanpy \
        jupyterlab \
        notebook \
        ipykernel \
        ipywidgets \
        tqdm \
        rich \
        pyyaml \
        requests \
        click \
        python-dotenv \
        cloudpickle \
        pytest \
        ruff \
        pillow

    # ============================================================
    # 4. PyTorch 2.10 + CUDA 12.8
    # ============================================================
    python -m pip install \
        torch==2.10.0 \
        torchvision==0.25.0 \
        torchaudio==2.10.0 \
        --index-url https://download.pytorch.org/whl/cu128

    # ============================================================
    # 5. PyPI packages
    # ============================================================
    python -m pip install \
        openTSNE \
        torchmetrics \
        lightning \
        tensorboard \
        transformers \
        datasets \
        accelerate \
        huggingface-hub \
        safetensors \
        tokenizers \
        sentencepiece \
        neuromaps \
        brainspace \
        opencv-python-headless \
        tabpfn==8.1.0

    # ============================================================
    # 6. Dependency sanity check
    # ============================================================
    python -m pip check

    # ============================================================
    # 7. Cleanup inside the image
    # ============================================================
    mamba clean --all --yes
    python -m pip cache purge || true

    apt-get clean
    rm -rf /var/lib/apt/lists/*
    rm -rf /root/.cache

%test
    python --version
    python -c "import torch; print('PyTorch:', torch.__version__); print('PyTorch CUDA:', torch.version.cuda)"
    python -c "import numpy, scipy, pandas, sklearn"
    python -c "import xgboost, lightgbm, catboost"
    python -c "import openTSNE, nibabel, nilearn, transformers"
    python -c "import importlib.metadata as m; import tabpfn; print('TabPFN:', m.version('tabpfn'))"
    python -m pip check

%runscript
    exec python "$@"
